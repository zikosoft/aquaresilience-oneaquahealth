# =============================================================================
# AquaResilience — Environment Configuration Example
# Copy to `.env` and fill in real values. NEVER commit the real `.env` file.
# =============================================================================

# --- General ---
ENVIRONMENT=development
APP_NAME=AquaResilience
API_V1_PREFIX=/api/v1
DEFAULT_CITY=toulouse

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080
# Fernet key used to encrypt AI provider secrets at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRETS_ENCRYPTION_KEY=change-me-generate-a-fernet-key

# --- PostgreSQL / PostGIS ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=aquaresilience
POSTGRES_USER=aquaresilience
POSTGRES_PASSWORD=change-me-strong-password

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# --- CORS ---
# Comma-separated list of allowed origins for the browser frontend.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- Rate limiting ---
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# --- Demo / seed ---
SEED_DEMO_USER=true
DEMO_ADMIN_EMAIL=admin@aquaresilience.demo
DEMO_ADMIN_PASSWORD=change-me-demo-password

# --- Frontend (build-time, Vite) ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_DEFAULT_LOCALE=en
VITE_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json
VITE_MAP_DEFAULT_LON=1.4442
VITE_MAP_DEFAULT_LAT=43.6047
VITE_MAP_DEFAULT_ZOOM=11

# --- AI Providers (never set real keys here; configure via Settings UI) ---
# Providers are configured and stored server-side only (Settings > AI Provider).
# These are placeholders only, to document expected env-level fallbacks in CI/tests.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
