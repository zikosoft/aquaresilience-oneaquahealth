# =============================================================================
# AquaResilience — PRODUCTION environment (P5)
# Copy to `.env.production` and fill in real values. NEVER commit the real
# file. Used by docker-compose.prod.yml — see DEPLOYMENT.md for the full
# walkthrough (self-signed quick start vs. a real domain + Let's Encrypt).
#
# Every command against docker-compose.prod.yml needs --env-file
# .env.production explicitly (see that file's own top comment for why).
# =============================================================================

# --- Domain (required) ---
# The domain this deployment will be reached at. Use "localhost" for a
# local/demo run with the self-signed cert script — no DNS needed. Used by
# the reverse proxy (TLS server_name) and to build CORS_ORIGINS below.
DOMAIN=localhost

# --- General ---
ENVIRONMENT=production
APP_NAME=AquaResilience
API_V1_PREFIX=/api/v1
DEFAULT_CITY=toulouse

# --- Security (REQUIRED — the app refuses to start in production with the
# dev-only defaults from .env.example, see app/core/config.py) ---
# Generate real values, do not reuse the ones from .env.example:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRETS_ENCRYPTION_KEY=

# --- PostgreSQL / PostGIS (REQUIRED — must not be the dev default) ---
POSTGRES_DB=aquaresilience
POSTGRES_USER=aquaresilience
POSTGRES_PASSWORD=

# --- Redis ---
REDIS_DB=0

# --- CORS ---
# Same-origin via the reverse proxy in the normal case — this mostly
# matters for direct/cross-origin API callers. docker-compose.prod.yml
# already sets this to https://${DOMAIN} on the backend service; only
# override it here if you need something different.
# CORS_ORIGINS=https://localhost

# --- Rate limiting ---
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# --- Environmental data ingestion ---
ENABLE_INGESTION_SCHEDULER=true
INGESTION_TICK_SECONDS=300

# --- Demo / seed ---
# Keep this true and use the known demo credentials while this is a
# hackathon submission judges need to log into. Set SEED_DEMO_USER=false
# and change the password if this ever runs beyond the submission window.
# Set your own DEMO_ADMIN_EMAIL / DEMO_ADMIN_PASSWORD in .env.production
# BEFORE the first start, so the account is created with them (never with
# the defaults published in the repository).
SEED_DEMO_USER=true
DEMO_ADMIN_EMAIL=admin@aquaresilience.demo
DEMO_ADMIN_PASSWORD=change-me-demo-password
# true = the shared demo admin account and the Administrator role cannot be
# edited, deactivated, deleted or re-permissioned through the API (creating
# other users and all other settings stay open).
LOCK_DEMO_ADMIN=true

# --- Analytics (optional) ---
# Google Analytics 4 measurement id, e.g. G-XXXXXXXXXX. Leave empty to disable.
# Can be changed after deployment: edit this file, then run
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d frontend
# (no rebuild needed).
GA_MEASUREMENT_ID=

# --- Let's Encrypt (only needed once you run the real-certificate flow —
# see DEPLOYMENT.md; not used by the self-signed quick start) ---
LETSENCRYPT_EMAIL=
