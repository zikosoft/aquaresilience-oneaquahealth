# --- Environment / secrets ---
.env
.env.*
!.env.example
!.env.production.example
*.pem
*.key

# --- P5 deploy: certbot's own Let's Encrypt state (never committed) ---
deploy/nginx/certs/

# --- Python / backend ---
backend/__pycache__/
backend/**/__pycache__/
backend/.venv/
backend/venv/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage

# --- Node / frontend ---
frontend/node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
# vite.config.ts is the source of truth; a same-named .js can appear here if
# `vue-tsc -b` is ever run without tsconfig.node.json's noEmit (now set) —
# Vite's config-file resolution prefers .js over .ts, so a stray compiled
# copy silently shadows real edits to vite.config.ts. Never commit it.
frontend/vite.config.js

# --- Docker / data ---
postgres-data/
redis-data/
*.log

# --- Editors / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- Alembic (keep versions, ignore local db files) ---
*.sqlite3
